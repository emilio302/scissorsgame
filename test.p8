pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
--screen = "menu"
screen="initial"
lifes=9
enemylife=10
enemymove=1
current_enemy=1
still_alive=true
cls(0)
palt(0,false) 
palt(11,true)
end

function _draw()
	if screen=="menu" then
		loadintro()
		end
	if screen=="initial" then
		initialsetup()
		screen="game"
		end
	if screen=="game" then
		loadmainscene()
		end
	if screen=="finishedgame" then
		finishedscene(still_alive)
		end
end

function _update()
 if btnp(button_accept) and screen=="menu" then
		screen="initial"
	end
	if btnp(button_accept) and screen=="finishedgame" then
		screen="menu"
	end
 if(screen=="game") then
	 currentcardselected()
 end
end
-->8
--dawing functions
function drawhand(hand,x,y)
	if cardinhandselected == 1 then
			drawcard(deck[hand[1]],35,80)
		else
			drawcard(deck[hand[1]],35,90)
		end
	if cardinhandselected == 2 then
			drawcard(deck[hand[2]],55,80)
		else
			drawcard(deck[hand[2]],55,90)
		end
	if cardinhandselected == 3 then
			drawcard(deck[hand[3]],75,80)
		else
			drawcard(deck[hand[3]],75,90)
		end
	if cardinhandselected == 4 then
		print("\#0cards",105,105,7)
		print("\#0"..#deck_todraw,113,111,7)
		end
	if cardinhandselected == 0 then
		print("\#0show",10,105,7)
		end	
	if btn(button_accept) and cardinhandselected==0 then
		showdiscardpile()
		end		 
end

function drawmap()
map(0,0,0,0,16,16)
end

function drawlife(life)
	spr(8,110,60,2,2)
	print(life,114,65,0)
end

function drawcard(card,x,y)
	spr(6,x,y,2,2)
	spr(card.move*2,x,y,2,2)
	circfill(x+1,y+2,3,6)
	print(card.value,x,y,0)
end

function drawenemy(enemy)
	x=32
	y=15
	--drawing arms
	armposition=y+(6+5*(flr(time() * 2) % 2))
	sspr(96,32,16,32,x-16,armposition,32,64)
	sspr(96,32,16,32,x+48,armposition,32,64,true)
	--drawing face
	headposition=(2*(flr(time() * 2) % 2))
	sspr(enemies[enemy].mask,32,32,16,x,y+headposition,64,32)
	sspr(enemies[enemy].face,48,32,16,x,y+headposition+32,64,32)
	--drawing moves
	drawenemymove()
	--drawing life
	drawenemylife()
end

function drawenemymove()
	local spr_texture = move_sprite[enemymove]
	circfill(15,35,10,6)
	spr(spr_texture,8,27,2,2,false,true)
	circ(15,35,10,0)
end

function drawenemylife()
	for i=1,enemylife do
		spr(35,10+(i*9),5,1,1)
	end
end

function drawtable()
	rectfill(7,80,120,110,4)
	for y = 80, 120, 8 do
		for x =8, 112, 8 do
			spr(32,x,y)
			end
		end
	drawdiscardpile()
	drawdrawpile()
end

function drawdrawpile()
	if #deck_todraw == 0 then
		spr(40,105,90,2,2)
	else
		spr(38,105,90,2,2)
	end
end

function drawdiscardpile()
	if #discardpile == 0 then
		spr(40,10,90,2,2)
	else
		drawcard(deck[discardpile[#discardpile]],10,90)
	end
end

function showdiscardpile()
	rectfill(30,25,100,110,0)
 print("dicard pile",40,30,7)
	print("card   value",40,38,7)
	local y=0
	for c in all(discardpile) do
		print(move[deck[c].move+1],40,50+(10*y),7)
		print(deck[c].value,80,50+(10*y),7)
		y=y+1
	end
end
-->8
--load main scene
function loadmainscene()
cls(6)
drawmap()
drawenemy(current_enemy)
drawtable()
drawhand(hand)
drawlife(lifes)
end

function initialsetup()
still_alive=true
shuffledeck()
getcard()
getcard()
getcard()
enemymove=getrandomenemymove()
print(hand,0,120)
end
-->8
--load intro
function loadintro()
cls(0)
print("welcome to",0,0)
print("sicissors card",0,12)
print("a rock and paper game",0,24)
print("please press down button",0,32)
end
-->8
--game core
deck_todraw={}
discardpile={}
hand={}
cardinhandselected=0

function shuffledeck()
deck_todraw={1,2,3,4,5,6,7,8,9}

deck_todraw=filtrar_array(deck_todraw,hand)

discardpile={}
	for i = #deck_todraw, 2, -1 do
 	local j = flr(rnd(i)) + 1
  deck_todraw[i], deck_todraw[j] = deck_todraw[j], deck_todraw[i]
	end
end

function getcard()
 if #deck_todraw == 0 then
 	shuffledeck()
 	end
	add(hand,deli(deck_todraw,1))
end

function discardcard(card)
	add(discardpile,card)
end

function currentcardselected()
	if(btnp(button_right)) and cardinhandselected < 4 then
		sfx(0)
		cardinhandselected=cardinhandselected+1
		end
	if(btnp(button_left)) and cardinhandselected > 0 then
		sfx(0)
		cardinhandselected=cardinhandselected-1
		end
	if btnp(button_accept) and cardinhandselected>0 and cardinhandselected <4 then
		playcard()
		end			
end

function playcard()
 local cardplayed=deck[hand[cardinhandselected]]
 local won = calculatewinmove(cardplayed.move+1,enemymove)
	if(won>0) then
		enemylife=enemylife-cardplayed.value
	elseif(won<0) then
		lifes=lifes-enemies[current_enemy].force
	end
	if(lifes<1) then
	still_alive=false
	screen=finishedgame
	end
	if(enemylife<1) then
	screen="finishedgame"
	end
	discardcard(deli(hand,cardinhandselected))
	getcard()
end

--aux function to filter array
function filtrar_array(original, remove)
	local new_array = {}
		for v in all(original) do
			if not includes(remove, v) then
   	add(new_array, v)
    end
   end 
 return new_array
end

function includes(table, value)
	for v in all(table) do
		if v == value then return true end
  end
	return false
end

function calculatewinmove(user,enemy)
	if(user==enemy) then
		return 0
	elseif(user==1 and enemy==2) then
		return 1
	elseif(user==2 and enemy==3) then
		return 1
	elseif(user==3 and enemy==1) then
		return 1
	else
		return -1
	end
end

function getrandomenemymove()
	return flr(rnd(3)) + 1
end
-->8
--constants
button_right=1
button_left=0
button_accept=2

deck={
	{move=0,value=1},
	{move=0,value=2},
	{move=0,value=3},
	{move=1,value=1},
	{move=1,value=2},
	{move=1,value=3},
	{move=2,value=1},
	{move=2,value=2},
	{move=2,value=3}
}

move={
"stone",
"scissors",
"paper"
}

enemies = {
	[1] = {mask=0,face=0,force=1},
	[2] = {mask=32,face=0,force=2},
	[3] = {mask=64,face=0,force=3}
}

--sprites
move_sprite={0,2,4}
