--constants
button_right=1
button_left=0
button_up=2
button_down=3
button_accept=5
button_secondary=4

user_positions={
"init",
"hand",
"debuffs"
}

deck={
	{move=0,value=1},
	{move=0,value=2},
	{move=0,value=3},
	{move=1,value=1},
	{move=1,value=2},
	{move=1,value=3},
	{move=2,value=1},
	{move=2,value=2},
	{move=2,value=3}
}

move={
"stone",
"scissors",
"paper"
}

powerups={
"discard",
"lives"
}

powerups_texts={
"gain 1 discard",
"gain 2 lives (max 9)"
}

defuffs_texts={
"nothing\nplay free",
"avoid losing\nwinning move can not be played",
"shield\nenemy can not lose lifes"
}

enemies = {
	[1] = {
		mask=0,
		face=0,
		force=1,
		debuffs={1,3},
		debuffs_probs={100,25}
		},
	[2] = {
		mask=32,
		face=0,
		force=2,
		debuffs={1,2,3},
		debuffs_probs={100,25,75}
	},
	[3] = {
		mask=64,
		face=0,
		force=3,
		debuffs={1,2,3},
		debuffs_probs={100,75,25}
	}
}

--sprites
move_sprite={0,2,4}

debuffs_sprites={160,162,164}

powerups_sprites={144,145}
