intro_y = -30
function loadintro()
cls(0)
sspr(0,96,32,32,35,intro_y,64,64)
if(intro_y<15) then
		intro_y=intro_y+((flr(time()*10)))
	else
	 intro_y=15
		print("welcome to",20,80)
		print("sicissors card",20,92)
		print("a rock and paper game",20,104)
		print("please press ❎ button",20,116)
		print(version,105,0)
	end
end
