pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	version="0.0.12"
	screen = "menu"
	--screen="initial"
	initial_lifes=9
	initial_enemylife=10
	position=user_positions[1]
	enemymove=1
	enemydebuff=1
	current_enemy=1
	last_boss=3
	still_alive=true
	powerup=""
	cls(0)
	palt(0,false) 
	palt(11,true)
	animations = {}
	music(0)
end

function _draw()
	if screen=="menu" then
		loadintro()
		end
	if screen=="initial" then
		initialsetup()
		screen="game"
		end
	if screen=="game" then
		loadmainscene()
		end
	if screen=="finishedgame" then
		finishedscene(still_alive)
		end
	if screen=="showinfo" and position==user_positions[3] then
		showinfo(defuffs_texts[enemydebuff])
		end
end

function _update()
 if btnp(button_accept) and screen=="menu" then
		screen="initial"
	end
	if btnp(button_accept) and screen=="finishedgame" and current_enemy<last_boss then
		if(still_alive) then
			setupnewround()
			screen="game"
		else
			screen="menu"
		end
	end
 if(screen=="game" or "showinfo") then
	 currentpositionelected()
 end
 --animations handler
 for anim in all(animations) do
  anim.timer -= 1
  if anim.timer <= 0 then
   del(animations, anim)
  end
 end
end

function getanimtimer(name)
 for anim in all(animations) do
  if anim.name == name then
   return anim.timer
  end
 end
end
