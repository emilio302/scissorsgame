--load main scene
function loadmainscene()
cls(6)
drawmap()
drawenemy(current_enemy)
drawtable()
drawhand(hand)
drawlife(lifes)
drawkeybinds()
end

function initialsetup()
still_alive=true
current_enemy=1
enemylife=initial_enemylife
lifes=initial_lifes
shuffledeck()
getcard()
getcard()
getcard()
enemymove=getrandomenemymove()
enemydebuff=getrandomenemydebuff()
music(-1)
end
